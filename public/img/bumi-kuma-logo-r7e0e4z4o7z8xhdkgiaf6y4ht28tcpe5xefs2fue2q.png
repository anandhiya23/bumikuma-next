<script>
document.addEventListener('DOMContentLoaded', function() {
  // Check if current URL starts with /id
  if (window.location.pathname.startsWith('/id')) {
    
    // Add small delay to ensure elements are loaded
    setTimeout(function() {
      // Target the specific flag element by its data-id with multiple selectors
      const flagImage = document.querySelector('[data-id="7951133"] img') || 
                       document.querySelector('.elementor-element-7951133 img') ||
                       document.querySelector('.header-widget-area img[alt*="Flag"]');
      const flagLink = document.querySelector('[data-id="7951133"] a') || 
                      document.querySelector('.elementor-element-7951133 a') ||
                      document.querySelector('.header-widget-area a[href*="bumikuma.com"]');
      
      if (flagImage && flagLink) {
        // Keep Indonesian flag, change image source and link to main English site
        flagImage.src = 'https://bumikuma.com/wp-content/uploads/2025/06/Group-1171275038.png';
        flagLink.href = 'https://bumikuma.com/';
      }
    }, 100);
    
    // Update company links in mobile and desktop menus
    const companyLinks = document.querySelectorAll('a[href*="-en/"]');
    
    companyLinks.forEach(link => {
      const currentHref = link.getAttribute('href');
      // Remove -en and add /id prefix
      const newHref = currentHref.replace('-en/', '/').replace('https://bumikuma.com/', 'https://bumikuma.com/id/');
      link.setAttribute('href', newHref);
    });
    
    // Update main menu links and text
    const menuLinks = [
      { selector: 'a[href="https://bumikuma.com/"]', newHref: 'https://bumikuma.com/id', newText: 'Beranda' },
      { selector: 'a[href="https://bumikuma.com/about/"]', newHref: 'https://bumikuma.com/id/tentang-kami', newText: 'Tentang Kami' },
      { selector: 'a[href="https://bumikuma.com/projects/"]', newHref: 'https://bumikuma.com/id/proyek', newText: 'Projects' },
      { selector: 'a[href="https://bumikuma.com/contact/"]', newHref: 'https://bumikuma.com/id/kontak-kami/', newText: 'Hubungi Kami' }
    ];
    
    menuLinks.forEach(item => {
      const links = document.querySelectorAll(item.selector);
      links.forEach(link => {
        link.setAttribute('href', item.newHref);
        const menuText = link.querySelector('.menu-text');
        if (menuText) {
          menuText.textContent = item.newText;
        }
      });
    });
    
    // Update Companies menu text
    const companiesMenuText = document.querySelectorAll('.menu-text');
    companiesMenuText.forEach(text => {
      if (text.textContent === 'Companies') {
        text.textContent = 'Perusahaan';
      }
    });
  }
});

</script><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 0 0" width="0" height="0" focusable="false" role="none" style="visibility: hidden; position: absolute; left: -9999px; overflow: hidden;"><defs><filter id="ast-img-color-filter"><feColorMatrix color-interpolation-filters="sRGB" type="matrix" values=" .299 .587 .114 0 0 .299 .587 .114 0 0 .299 .587 .114 0 0 .299 .587 .114 0 0 "></feColorMatrix><feComponentTransfer color-interpolation-filters="sRGB"><feFuncR type="table" tableValues="1 1"></feFuncR><feFuncG type="table" tableValues="1 1"></feFuncG><feFuncB type="table" tableValues="1 1"></feFuncB><feFuncA type="table" tableValues="1 1"></feFuncA></feComponentTransfer><feComposite in2="SourceGraphic" operator="in"></feComposite></filter></defs></svg>
